            },
            {
              "name": "language",
              "value": "es"
            },
            {
              "name": "task",
              "value": "transcribe"
            }
          ]
        },
        "options": {}
      },
      "id": "send-to-whisper-api",
      "name": "Send to Whisper API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        300
      ]
    }
  ],
  "connections": {
    "Select Audio File": {
      "main": [
        [
          {
            "node": "Send to Whisper API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}