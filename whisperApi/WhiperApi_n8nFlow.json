{
  "name": "Upload audio to Whisper API",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Transcribir audio",
        "formDescription": "Sube un archivo MP3/WAV/M4A para transcribirlo con faster-whisper.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "audio",
              "fieldType": "file",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode"
      },
      "id": "form-upload-audio",
      "name": "Select Audio File",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2,
      "position": [
        300,
        300
      ],
      "webhookId": "upload-audio-whisper"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://whisper-api:8000/transcribe",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
